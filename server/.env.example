# ISO 30414 Human Capital Reporting — Environment Variables
# Copy this file to .env and fill in the values

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"              # development | test | production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# URL frontend (comma-separated if multiple origins)
APP_URL="http://localhost:5173"

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iso30414?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-secure-random-string-minimum-32-chars"
JWT_EXPIRES_IN="8h"                 # e.g. 8h, 24h, 7d

# ─── File Storage ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
STORAGE_PATH="./storage"           # Absolute or relative path for generated report files

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"                    # info | warn | error

# ─── Development / Seed ───────────────────────────────────────────────────────
# Password for the initial admin seeded by prisma/seed.ts (dev only)
SEED_ADMIN_PASSWORD="change-me-before-seeding"
